<UserControl
    x:Class="CaeloWorks.NINA.Benchmark.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="220" d:DesignWidth="520">
    <!-- DataContext is expected to be a BenchmarkEngine -->
    <GroupBox Header="Sharing (submit results online)" Margin="5">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,3,10,3" Text="Endpoint URL" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. https://your-bench-site/api/runs" />

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,3,10,3" Text="Submit token" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding SubmitToken, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Shared secret required by the site to accept submissions" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,3,10,3" Text="Nickname" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Optional — shown next to your runs" />

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,3,10,3" Text="Machine name" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Optional — a label for this rig" />

            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#90A0B8"
                       Text="Submitting is manual (the Share button on each run). What is sent: your machine specs (CPU, GPU, RAM, OS, power plan) and the per-function timings — no images, no personal data." />
        </Grid>
    </GroupBox>
</UserControl>
