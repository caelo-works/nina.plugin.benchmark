<UserControl
    x:Class="CaeloWorks.NINA.Benchmark.View.BenchmarkResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="320" d:DesignWidth="560">
    <!-- DataContext is expected to be a BenchmarkEngine -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <GroupBox Header="Benchmark results" Margin="5">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Controls -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    Padding="12,4"
                    Content="Run benchmark"
                    Command="{Binding RunBenchmarkCommand}" />
                <Button
                    Margin="6,0,0,0"
                    Padding="12,4"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="16,0,4,0" VerticalAlignment="Center" Text="Iterations:" />
                <TextBox Width="40" VerticalAlignment="Center" Text="{Binding Iterations, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Progress -->
            <Grid Grid.Row="1" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Grid.Column="0"
                    Height="14"
                    Minimum="0" Maximum="1"
                    Value="{Binding ProgressValue}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding StatusText}" />
            </Grid>

            <!-- History -->
            <DataGrid
                Grid.Row="2"
                ItemsSource="{Binding History}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DisplayTimestamp}" />
                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" />
                    <DataGridTextColumn Header="Total (ms)" Binding="{Binding TotalMs, StringFormat=N0}" />
                    <DataGridTextColumn Header="Load" Binding="{Binding LoadMs, StringFormat=N0}" />
                    <DataGridTextColumn Header="Debayer" Binding="{Binding DebayerMs, StringFormat=N0}" />
                    <DataGridTextColumn Header="Stats" Binding="{Binding StatisticsMs, StringFormat=N0}" />
                    <DataGridTextColumn Header="Stretch" Binding="{Binding StretchMs, StringFormat=N0}" />
                    <DataGridTextColumn Header="StarDet" Binding="{Binding StarDetectionMs, StringFormat=N0}" />
                    <DataGridTextColumn Header="Stars" Binding="{Binding TotalStarsDetected}" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding System.Cpu}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </GroupBox>
</UserControl>
