<UserControl
    x:Class="CaeloWorks.NINA.Benchmark.View.BenchmarkResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="460" d:DesignWidth="560">
    <!-- DataContext is expected to be a BenchmarkEngine -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Tabler icons (MIT), stroked to match the button text colour. -->
        <StreamGeometry x:Key="CaeloIcon_Play">M7 4v16l13 -8l-13 -8</StreamGeometry>
        <StreamGeometry x:Key="CaeloIcon_Trash">M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3</StreamGeometry>
        <StreamGeometry x:Key="CaeloIcon_Details">M11 15a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M18.5 18.5l2.5 2.5 M4 6h16 M4 12h4 M4 18h4</StreamGeometry>
        <StreamGeometry x:Key="CaeloIcon_Cancel">M18 6l-12 12 M6 6l12 12</StreamGeometry>
        <StreamGeometry x:Key="CaeloIcon_Share">M6 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M18 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M18 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M8.7 10.7l6.6 -3.4 M8.7 13.3l6.6 3.4</StreamGeometry>
        <StreamGeometry x:Key="CaeloIcon_World">M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18</StreamGeometry>
        <StreamGeometry x:Key="CaeloIcon_Download">M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4v12</StreamGeometry>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource ButtonForegroundBrush}" />
        </Style>
    </UserControl.Resources>
    <GroupBox Header="Benchmark results" Margin="5">
        <Grid>

        <!-- Test frames are downloaded separately; show the normal UI only once they're ready. -->
        <Grid Margin="5" Visibility="{Binding IsTestSetReady, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Controls -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button HorizontalContentAlignment="Left" Padding="16,6,16,6" Command="{Binding RunBenchmarkCommand}">
                        <StackPanel Orientation="Horizontal" Margin="10,3">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource CaeloIcon_Play}" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Run benchmark" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" HorizontalContentAlignment="Left" Padding="16,6,16,6"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="10,3">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource CaeloIcon_Cancel}" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Cancel" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" HorizontalContentAlignment="Left" Padding="16,6,16,6"
                            Command="{Binding ClearHistoryCommand}"
                            ToolTip="Remove every saved benchmark run from the history">
                        <StackPanel Orientation="Horizontal" Margin="10,3">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource CaeloIcon_Trash}" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Clear all" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Best score:" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"
                               Text="{Binding BestScore}" />
                </StackPanel>
            </Grid>

            <!-- Progress -->
            <Grid Grid.Row="1" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Height="14" Minimum="0" Maximum="1" Value="{Binding ProgressValue}" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" />
            </Grid>

            <!-- Latest run: per-function breakdown -->
            <GroupBox Grid.Row="2" Margin="0,0,0,8" Header="Latest run — per function"
                      Visibility="{Binding LatestResult, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding LatestResult.Functions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas,Courier New" />
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="Consolas,Courier New" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding Note}" Opacity="0.6" FontStyle="Italic" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="2,6,0,0" FontWeight="Bold" FontFamily="Consolas,Courier New"
                               Text="{Binding LatestResult.TotalMs, StringFormat='Total (primitives only = score basis): {0:N2} ms'}" />
                </StackPanel>
            </GroupBox>

            <!-- History -->
            <DataGrid Grid.Row="3" ItemsSource="{Binding History}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Resources>
                    <!-- Keep selected-row text readable when the grid loses focus (the default cell
                         template otherwise falls back to black system "inactive selection" colours). -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A3550" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#222B40" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E2E8F0" />
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <!-- Inherit N.I.N.A.'s themed row style, only adding the expand binding. -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="DetailsVisibility"
                                Value="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="3,2" Padding="14,4,14,4" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Margin="10,3">
                                            <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource CaeloIcon_Details}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Details" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Before sharing: submit this run. -->
                                    <Button Margin="3,2" Padding="14,4,14,4" HorizontalContentAlignment="Left"
                                            ToolTip="Submit this run to the sharing site"
                                            Visibility="{Binding IsNotShared, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.SubmitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.NotSubmitting, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal" Margin="10,3">
                                            <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource CaeloIcon_Share}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Share" />
                                        </StackPanel>
                                    </Button>
                                    <!-- After sharing: open the run's page in the default browser. -->
                                    <Button Margin="3,2" Padding="14,4,14,4" HorizontalContentAlignment="Left"
                                            ToolTip="{Binding ShareUrl}"
                                            Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.OpenRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Margin="10,3">
                                            <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource CaeloIcon_World}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="View" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Date" Binding="{Binding DisplayTimestamp}" Width="150" MinWidth="130" />
                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="80" MinWidth="60" />
                    <DataGridTextColumn Header="Total (ms)" Binding="{Binding TotalMs, StringFormat=N0}" Width="100" MinWidth="80" />
                    <DataGridTextColumn Header="Power plan" Binding="{Binding System.PowerPlan}" Width="*" MinWidth="150" />
                    <DataGridTextColumn Header="NINA" Binding="{Binding System.HostVersion}" Width="120" MinWidth="90" />
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Margin="4,4,4,10" Padding="8" BorderThickness="1" BorderBrush="#40808080">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- System snapshot at test time -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock FontWeight="Bold" Text="System at test time" Margin="0,0,0,4" />
                                    <TextBlock FontFamily="Consolas,Courier New"
                                               Text="{Binding System.Summary, TargetNullValue='(not recorded)'}" />
                                </StackPanel>
                                <!-- Per sub-test breakdown -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold" Text="Per-function timing" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Functions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontFamily="Consolas,Courier New" Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" FontFamily="Consolas,Courier New" TextAlignment="Right" Text="{Binding Display}" />
                                                    <TextBlock Grid.Column="2" Margin="8,0,0,0" Opacity="0.6" FontStyle="Italic" Text="{Binding Note}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,6,0,0" FontWeight="Bold" FontFamily="Consolas,Courier New"
                                               Text="{Binding TotalMs, StringFormat='Total (primitives only = score basis): {0:N2} ms'}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Grid>

        <!-- Test set not present: short message + download button. -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430" Margin="24"
                    Visibility="{Binding ShowTestSetPrompt, Converter={StaticResource BoolToVis}}">
            <Path Style="{StaticResource IconPath}" Width="34" Height="34" HorizontalAlignment="Center"
                  Opacity="0.7" Data="{StaticResource CaeloIcon_Download}" />
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85"
                       Text="{Binding TestSetMessage}" />
            <Button HorizontalAlignment="Center" Margin="0,16,0,0" HorizontalContentAlignment="Left"
                    Padding="16,6,16,6" Command="{Binding DownloadTestSetCommand}">
                <StackPanel Orientation="Horizontal" Margin="10,3">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource CaeloIcon_Download}" />
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Download test set" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Test set downloading: progress bar with remaining size and throughput. -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470" Margin="24"
                    Visibility="{Binding IsDownloadingTestSet, Converter={StaticResource BoolToVis}}">
            <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="Downloading test set…" />
            <ProgressBar Height="16" Minimum="0" Maximum="1" Margin="0,12,0,6" Value="{Binding DownloadFraction}" />
            <Grid>
                <TextBlock HorizontalAlignment="Left" Opacity="0.85" FontFamily="Consolas,Courier New"
                           Text="{Binding DownloadProgressText}" />
                <TextBlock HorizontalAlignment="Right" Opacity="0.85" FontFamily="Consolas,Courier New"
                           Text="{Binding DownloadSpeedText}" />
            </Grid>
            <Button HorizontalAlignment="Center" Margin="0,14,0,0" HorizontalContentAlignment="Left"
                    Padding="14,4,14,4" Command="{Binding CancelCommand}">
                <StackPanel Orientation="Horizontal" Margin="10,3">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource CaeloIcon_Cancel}" />
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Cancel" />
                </StackPanel>
            </Button>
        </StackPanel>

        </Grid>
    </GroupBox>
</UserControl>
